# Environment Variables Template
# Copy this file to .env and fill in your actual values
# DO NOT commit the .env file to version control

# Database Configuration
MONGO_URI=mongodb+srv://your_username:your_password@cluster.mongodb.net/trading-db?retryWrites=true&w=majority&appName=Cluster0

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=your_refresh_token_secret
REFRESH_TOKEN_EXPIRY=30d

# Email Configuration (Elastic Email or other SMTP provider)
MAIL_HOST=smtp.elasticemail.com
MAIL_USER=your_email@domain.com
MAIL_PASS=your_email_password_or_api_key
MAIL_PORT=2525
MAIL_FROM=your_email@domain.com

# Registration & Socket Configuration
REGISTER_SECRET=your_register_secret
REGISTER_SECRET_EXPIRY=10m
SOCKET_TOKEN_SECRET=your_socket_token_secret
SOCKET_TOKEN_EXPIRY=1d
REFRESH_SOCKET_TOKEN_SECRET=your_refresh_socket_token_secret
REFRESH_SOCKET_TOKEN_EXPIRY=3d

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Optional: Server Configuration (uncomment if needed)
# PORT=4000
# SOCKET_PORT=4001
# WEBSERVER_URI=http://localhost:3000
# For multiple origins, use comma-separated values:
# WEBSERVER_URI=http://localhost:3000,http://localhost:3001,https://yourdomain.com